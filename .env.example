# --- LLM (strategy, storyboard, creative QA) ---
# Free key from https://aistudio.google.com/apikey . If unset, Gemini is called through Vertex AI instead.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash

# --- Video (Veo on Vertex AI, paid from the Google Cloud trial credits) ---
# Auth: run `gcloud auth application-default login` once.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
VEO_MODEL=veo-3.1-generate-001
VEO_RESOLUTION=1080p
VEO_GENERATE_AUDIO=true

# --- Pipeline tuning (optional) ---
# VIDEO_MAX_ATTEMPTS=3
# VIDEO_CONCURRENCY=3
# VIDEO_POLL_INTERVAL_MS=10000
# VIDEO_TIMEOUT_MS=900000
# FONT_FILE=C:/Windows/Fonts/segoeuib.ttf
